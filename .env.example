# Server-only settings for the /api functions. None of these reach the browser.
# Locally: copy to .env. On Vercel: Project → Settings → Environment Variables.

# Arcade API key (platform.arcade.ai → API keys). Starts with arcade_sk_live_.
ARCADE_API_KEY=
# Contact sent in the User-Agent; Arcade's edge requires one.
ARCADE_CONTACT=yash@videoselz.com

# Code visitors type before anything that costs money. Leave empty to skip.
ACCESS_CODE=

# The Videoselz import endpoint (Shopify product + videos) and its shared key.
# Email yash@videoselz.com for the key.
VIDEOSELZ_URL=https://videoselz--development.gadget.app/arcade-public/studio
VIDEOSELZ_KEY=
